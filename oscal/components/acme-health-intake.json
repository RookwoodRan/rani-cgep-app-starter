    "components": [
      {
        "uuid": "d835b273-faf6-4d4c-8b95-06481a8a2430",
        "type": "software",
        "title": "acme-health-intake",
        "description": "Patient intake API on AWS (API Gateway, Lambda, DynamoDB, S3) in ca-central-1, with a Terraform GRC baseline, OPA/Rego policy gate, and a signed evidence pipeline.",
        "purpose": "Process patient intake submissions with controls enforced as code.",
        "props": [
          {
            "name": "source-repository",
            "value": "https://github.com/RookwoodRan/rani-cgep-app-starter"
          }
        ],
        "control-implementations": [
          {
            "uuid": "5d7983ca-6de2-4825-b6f1-0455c4fb4bcf",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-171/rev3/json/NIST_SP800-171_rev3_catalog.json",
            "description": "CMMC Level 2 practices, expressed as the NIST SP 800-171 Rev 3 requirements they are drawn from.",
            "implemented-requirements": [
              {
                "uuid": "afdce51d-9318-40c2-90a5-19ec0d364980",
                "control-id": "SP_800_171_03.13.11",
                "description": "PHI at rest is encrypted with a customer-managed KMS key with annual rotation: the S3 uploads bucket (SSE-KMS) and the DynamoDB intake table. The key is under customer control, not the AWS-owned or AWS-managed default.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "cmmc-practice",
                    "value": "SC.L2-3.13.11"
                  },
                  {
                    "name": "starter-gap",
                    "value": "GAP-01, GAP-02"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_kms_key.phi"
                  },
                  {
                    "name": "arn",
                    "value": "arn:aws:kms:ca-central-1:006419717013:key/c36812fb-183c-46da-b01f-fff32ea681e4"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_s3_bucket_server_side_encryption_configuration.uploads"
                  },
                  {
                    "name": "resource-id",
                    "value": "acme-health-intake-uploads-08fa0596"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_dynamodb_table.intake"
