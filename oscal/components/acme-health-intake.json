                    "name": "rego-policy",
                    "value": "policies/sc13_11_s3_cmk.rego"
                  },
                  {
                    "name": "rego-policy",
                    "value": "policies/sc13_11_dynamodb_cmk.rego"
                  }
                ],
                "links": [
                  {
                    "href": "#e3ad0671-08b7-4270-b6f7-370cb42997ab",
                    "rel": "evidence",
                    "text": "Signed pipeline evidence: terraform plan and policy-gate results from the merge to main."
                  }
                ]
              },
              {
                "uuid": "903c167a-f3f1-469a-a3c2-bbc1999886db",
                "control-id": "SP_800_171_03.13.08",
                "description": "Every S3 bucket carries a bucket policy that denies any request not made over TLS (aws:SecureTransport = false), protecting CUI/PHI in transit to and from storage.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "cmmc-practice",
                    "value": "SC.L2-3.13.8"
                  },
                  {
                    "name": "starter-gap",
                    "value": "GAP-03"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_s3_bucket_policy.uploads_tls_only"
                  },
                  {
                    "name": "resource-id",
                    "value": "acme-health-intake-uploads-08fa0596"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_s3_bucket_policy.evidence_tls_only"
                  },
                  {
                    "name": "resource-id",
