              },
              {
                "uuid": "5ebd03b2-b13d-4e87-9ee5-8a404d2ad658",
                "control-id": "SP_800_171_03.08.09",
                "description": "S3 versioning is enabled on the uploads bucket and the evidence vault so overwritten or deleted PHI is recoverable, and the stored versions are encrypted with the customer-managed key. This is a partial fit: the Rev 3 requirement is about cryptographic protection of backups, and no separate backup service is deployed.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "partial"
                  },
                  {
                    "name": "cmmc-practice",
                    "value": "MP.L2-3.8.9"
                  },
                  {
                    "name": "starter-gap",
                    "value": "GAP-04"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_s3_bucket_versioning.uploads"
                  },
                  {
                    "name": "resource-id",
                    "value": "acme-health-intake-uploads-08fa0596"
                  },
                  {
                    "name": "terraform-address",
                    "value": "aws_s3_bucket_versioning.evidence"
                  },
                  {
                    "name": "resource-id",
                    "value": "acme-health-intake-evidence-08fa0596"
                  },
                  {
                    "name": "rego-policy",
                    "value": "policies/mp3_8_9_versioning.rego"
                  }
                ],
                "links": [
                  {
                    "href": "#e3ad0671-08b7-4270-b6f7-370cb42997ab",
                    "rel": "evidence",
                    "text": "Signed pipeline evidence: terraform plan and policy-gate results from the merge to main."
                  },
                  {
                    "href": "#b992dfb0-8720-4fbf-a767-413960c9fddd",
