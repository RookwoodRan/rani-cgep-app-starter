                    "rel": "evidence",
                    "text": "Signed pipeline evidence: terraform plan and policy-gate results from the merge to main."
                  }
                ]
              },
              {
                "uuid": "85e669a0-dfe7-4f90-922d-d5944f6d5819",
                "control-id": "SP_800_171_03.01.05",
                "description": "The Lambda execution role is limited to dynamodb:PutItem on the intake table, s3:PutObject under uploads/, and the KMS actions needed for the data key. No service-wide wildcards.",
                "props": [
                  {
                    "name": "implementation-status",
